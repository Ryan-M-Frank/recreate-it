{
  "name": "reinventit-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [
    { "pattern": "reinventit.org", "custom_domain": true },
    { "pattern": "www.reinventit.org", "custom_domain": true }
  ]
}
