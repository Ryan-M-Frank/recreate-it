{
  "name": "reinventit-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true
  },
  "routes": [
    {
      "pattern": "reinventit.org",
      "custom_domain": true
    },
    {
      "pattern": "www.reinventit.org",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "node build.mjs"
  }
}
